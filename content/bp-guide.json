  "version": 1,
  "steps": [
    {
      "id": "prep",
      "text": "Nothing to eat or drink for 30 minutes before.",
      "detail": "Also no caffeine, smoking or exercise in the last 30 minutes."
    },
    {
      "id": "bladder",
      "text": "Empty your bladder."
    },
    {
      "id": "cuff",
      "text": "Put the cuff on your bare upper arm, snug but not tight."
    },
    {
      "id": "anchor",
      "text": "Anchor yourself so you can stay still and relaxed.",
      "adaptation": true
    },
    {
      "id": "rest",
      "text": "Rest quietly for 5 minutes.",
      "timerSeconds": 300
    },
    {
      "id": "position",
      "text": "Keep the cuff at chest height. Stay silent while it inflates."
    },
    {
      "id": "reading-1",
      "text": "Take reading 1."
    },
    {
      "id": "reading-2",
      "text": "Wait 1 minute, then take reading 2.",
      "timerSeconds": 60
    }
